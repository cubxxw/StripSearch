# StripSearch Web Alpha — server-only environment.
# Copy to `.env` (ignored by Git) and fill only if you want the optional providers.
# The server never exposes these values to the browser bundle, logs or /api/health.

# Optional. Without it, Exa stays visibly "未配置" and the Exa source is disabled.
# Never commit a real key.
EXA_API_KEY=

# Optional. GitHub public reads work without a token; a token raises the anonymous
# rate limit only. Server-side only.
GITHUB_TOKEN=

# Overrides: bind stays loopback-only. Remote hosts are rejected by config.
# PORT=4392
# STRIPSEARCH_DATA_DIR=./apps/web/.data
# STRIPSEARCH_PUBLIC_ORIGIN=http://localhost:4392
